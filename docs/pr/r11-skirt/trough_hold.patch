+def _trough_hold(off, row):
+    """Radial offset (px, <= 0; shaped (NF, N_RINGS)) that keeps every trough
+    of the cloth off (NF, N_RINGS) open down to the hem (TROUGH_*): from
+    TROUGH_T0 down, each ring's troughs (local minima of the ring after a
+    TROUGH_U-deg Gaussian, at least TROUGH_MIN px inside its TROUGH_LP-deg
+    low-pass; of minima closer than TROUGH_TRACK deg the deepest) are
+    matched to the nearest trough of the ring above (within TROUGH_TRACK
+    deg; a trough missed for one ring is carried over it) and inherit its
+    running maximum depth; a trough shallower than TROUGH_HOLD of that (less
+    TROUGH_MOUTH over the last TROUGH_MOUTH_H px above the hem) sinks by the
+    difference (x TROUGH_GAIN, as the dip also lowers the low-pass it is
+    measured against), in a flat-bottomed dip as wide as the trough. The
+    term is then eased along the length (a [1, 2, 1] filter, twice), so no
+    ring steps. row: the hem row per sample."""
+    deg = NF / 360.0
+    T = np.array(T_STEPS)
+    out = np.zeros_like(off)
+    idx = np.arange(NF)
+    tr_j, tr_m, tr_age = np.zeros(0), np.zeros(0), np.zeros(0)   # tracks: sample, max depth, rings missed
+    rings = np.nonzero(T >= TROUGH_T0)[0]
+    for r in rings:
+        o = _smooth_loop(off[:, r], TROUGH_U * deg)
+        dep = _smooth_loop(off[:, r], TROUGH_LP * deg) - o
+        mins = np.nonzero((o <= np.roll(o, 1)) & (o < np.roll(o, -1)) & (dep > TROUGH_MIN))[0]
+        # of minima closer than TROUGH_TRACK, the deepest
+        keep = [j for j in mins
+                if not any(abs((k - j + NF / 2) % NF - NF / 2) <= TROUGH_TRACK * deg and
+                           (dep[k] > dep[j] or (dep[k] == dep[j] and k < j)) for k in mins if k != j)]
+        mins = np.array(keep, dtype=np.int64)
+        best = dep[mins].copy()
+        used = np.zeros(len(tr_j), dtype=bool)
+        if len(tr_j) and len(mins):
+            gap = np.abs((mins[:, None] - tr_j[None, :] + NF / 2) % NF - NF / 2)
+            k = np.argmin(gap, axis=1)
+            near = gap[np.arange(len(mins)), k] <= TROUGH_TRACK * deg
+            best[near] = np.maximum(best[near], tr_m[k[near]])
+            used[k[near]] = True
+        h = (1.0 - T[r]) * (row[mins] - TOP_ROW)                  # px above the hem
+        mouth = TROUGH_MOUTH * np.clip(1.0 - h / TROUGH_MOUTH_H, 0.0, 1.0) ** 2
+        need = TROUGH_HOLD * best * (1.0 - mouth) - dep[mins]
+        for j, d in zip(mins, need):
+            if d <= 0.0:
+                continue
+            # the trough's half-width at half its depth
+            lo = hi = 0
+            while lo < NF // 8 and dep[(j - lo) % NF] > 0.5 * dep[j]:
+                lo += 1
+            while hi < NF // 8 and dep[(j + hi) % NF] > 0.5 * dep[j]:
+                hi += 1
+            sig = np.clip(TROUGH_W * 0.5 * (lo + hi), TROUGH_SIG[0] * deg, TROUGH_SIG[1] * deg)
+            x = ((idx - j + NF / 2) % NF - NF / 2) / sig
+            out[:, r] = np.minimum(out[:, r], -TROUGH_GAIN * d * np.exp(-0.5 * x ** 4))   # flat-bottomed (U)
+        # tracks for the next ring: this ring's troughs, and those of the
+        # ring above that found none here (once)
+        old = ~used & (tr_age < 1)
+        tr_j = np.concatenate([mins.astype(np.float64), tr_j[old]])
+        tr_m = np.concatenate([best, tr_m[old]])
+        tr_age = np.concatenate([np.zeros(len(mins)), tr_age[old] + 1])
+    for _ in range(2):              # ease along the length: no ring steps
+        o = out[:, rings]
+        p = np.concatenate([o[:, :1], o, o[:, -1:]], axis=1)
+        out[:, rings] = 0.25 * p[:, :-2] + 0.5 * p[:, 1:-1] + 0.25 * p[:, 2:]
+    return out
+
